<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutSheetFavoritos"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Destinos favoritos"
        android:text="Mis Favoritos"
        android:textColor="@color/primary_yellow"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFavoritosVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="No tenés destinos guardados aún.\nBuscá un destino y tocá ★ para guardarlo."
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvSheetFavoritos"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="10dp"
        android:divider="#333333"
        android:dividerHeight="1dp"
        android:nestedScrollingEnabled="true" />

</LinearLayout>
