<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutSheetContactos"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Menú de contactos"
        android:text="Contactos"
        android:textColor="@color/primary_yellow"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:text="Elegí a quién avisar por SMS al llegar o gestioná tu lista."
        android:textColor="#AAAAAA"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAsignarContacto"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="Asignar contacto al viaje"
        android:text="Asignar contacto al viaje"
        android:textColor="@color/primary_yellow"
        android:textSize="15sp"
        android:textStyle="bold"
        app:strokeColor="@color/primary_yellow"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContactos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:contentDescription="Gestionar contactos"
        android:text="Gestionar contactos"
        android:textColor="@color/text_black"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_yellow" />

</LinearLayout>
