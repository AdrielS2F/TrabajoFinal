<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <!-- Mapa OpenStreetMap -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Panel Superior: Búsqueda y Accesos Directos -->
    <LinearLayout
        android:id="@+id/layoutSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="12dp"
        android:background="@color/card_background"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Campo Origen -->
        <EditText
            android:id="@+id/etOrigin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableEnd="@android:drawable/ic_menu_close_clear_cancel"
            android:hint="Origen (ej: Mi ubicación)"
            android:inputType="text"
            android:textColor="@color/text_white"
            android:textColorHint="#AAAAAA"
            android:textSize="14sp" />

        <!-- Campo Destino + Botón Estrella Favorito -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etDestination"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableEnd="@android:drawable/ic_menu_close_clear_cancel"
                android:hint="Destino (ej: Unicenter)"
                android:inputType="text"
                android:textColor="@color/text_white"
                android:textColorHint="#AAAAAA"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnSaveFavorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Guardar Destino Favorito"
                android:src="@android:drawable/btn_star_big_off"
                app:tint="@color/primary_yellow" />

        </LinearLayout>

        <!-- Botón Principal: Buscar Ruta (a lo largo) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Buscar Ruta"
            android:textColor="@color/text_black"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_yellow" />

        <!-- Pestañita para Desplegar / Contraer Opciones -->
        <LinearLayout
            android:id="@+id/layoutToggleMore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="4dp">

            <TextView
                android:id="@+id/tvToggleMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Más opciones ▼"
                android:textColor="@color/primary_yellow"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Panel Desplegable (Oculto por defecto) -->
        <LinearLayout
            android:id="@+id/layoutExpandableOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContactos"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Contactos"
                android:textColor="@color/primary_yellow"
                android:textStyle="bold"
                app:strokeColor="@color/primary_yellow"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDestinosFrecuentes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Favoritos"
                android:textColor="@color/primary_yellow"
                android:textStyle="bold"
                app:strokeColor="@color/primary_yellow"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Botones de Zoom flotantes (+) y (-) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/layoutControls"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoomIn"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:padding="0dp"
            android:text="+"
            android:textColor="@color/text_black"
            android:textSize="22sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_yellow"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoomOut"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="0dp"
            android:text="-"
            android:textColor="@color/text_black"
            android:textSize="22sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_yellow"
            app:cornerRadius="24dp" />
    </LinearLayout>

    <!-- Panel Inferior: Controles de Simulación y Monitoreo -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="12dp"
        android:background="@color/card_background"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvModeLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Modo Simulacion"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchSimulationMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="@color/card_background"
                android:trackTint="@color/primary_yellow"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvRadiusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Radio de Alerta: 300 m"
            android:textColor="@color/primary_yellow"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbRadius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="880"
            android:progress="180"
            android:progressTint="@color/primary_yellow"
            android:thumbTint="@color/primary_yellow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartTracking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Iniciar Monitoreo"
            android:textColor="@color/text_black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_yellow" />
    </LinearLayout>

</RelativeLayout>