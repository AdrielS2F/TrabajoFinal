<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <!-- Pantalla Principal en ConstraintLayout (fácil de mover en el editor visual) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Mapa OpenStreetMap -->
        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="Mapa"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Panel Superior: Origen (+ Engranaje), Destino (+ Estrella) y Buscar -->
        <LinearLayout
            android:id="@+id/layoutSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@color/card_background"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Campo Origen + Botón Engranaje -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <AutoCompleteTextView
                    android:id="@+id/etOrigin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:completionThreshold="3"
                    android:drawableEnd="@android:drawable/ic_menu_close_clear_cancel"
                    android:dropDownVerticalOffset="0dp"
                    android:hint="Origen"
                    android:inputType="text"
                    android:textColor="@color/text_white"
                    android:textColorHint="#AAAAAA"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnToggleMode"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Cambiar entre Modo Simulación y Modo Real"
                    android:padding="4dp"
                    android:src="@drawable/ic_settings_gear"
                    app:tint="@color/primary_yellow" />
            </LinearLayout>

            <!-- Campo Destino + Botón Estrella Favorito -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <AutoCompleteTextView
                    android:id="@+id/etDestination"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:completionThreshold="3"
                    android:contentDescription="Ingresar destino"
                    android:drawableEnd="@android:drawable/ic_menu_close_clear_cancel"
                    android:hint="Destino"
                    android:inputType="text"
                    android:textColor="@color/text_white"
                    android:textColorHint="#AAAAAA"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnSaveFavorite"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Guardar Destino Favorito"
                    android:src="@android:drawable/btn_star_big_off"
                    app:tint="@color/primary_yellow" />
            </LinearLayout>

            <!-- Botón Principal: Buscar Ruta -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="Buscar ruta"
                android:text="Buscar Ruta"
                android:textColor="@color/text_black"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_yellow" />
        </LinearLayout>

        <!-- Botones de Zoom flotantes (+) y (-) -->
        <LinearLayout
            android:id="@+id/layoutZoomButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/layoutControls"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutSearch"
            app:layout_constraintVertical_bias="0.45"
            app:layout_goneMarginBottom="96dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoomIn"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:contentDescription="Acercar mapa"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/text_black"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_yellow"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoomOut"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Alejar mapa"
                android:padding="0dp"
                android:text="-"
                android:textColor="@color/text_black"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_yellow"
                app:cornerRadius="24dp" />
        </LinearLayout>

        <!-- Panel de Monitoreo (editar en layout_panel_monitoreo.xml) -->
        <include
            android:id="@+id/layoutControls"
            layout="@layout/layout_panel_monitoreo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- BottomSheet Deslizable (editar contenidos en layout_sheet_favoritos.xml y layout_sheet_contactos.xml) -->
    <LinearLayout
        android:id="@+id/bottomSheetMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="88dp"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        tools:visibility="gone">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="#666666" />

        <include
            android:id="@+id/layoutSheetFavoritos"
            layout="@layout/layout_sheet_favoritos"
            android:visibility="gone" />

        <include
            android:id="@+id/layoutSheetContactos"
            layout="@layout/layout_sheet_contactos"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Barra de Navegación Inferior (3 pestañas) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/card_background"
        android:elevation="16dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/selector_bottom_nav"
        app:itemTextColor="@color/selector_bottom_nav"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
